{
  "name": "dbx-cli",
  "version": "0.1.2",
  "description": "Profile-based MySQL and Redis CLI with readonly and timeout enforcement.",
  "type": "module",
  "homepage": "https://example.com/dbx#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git.com/your-org/dbx.git"
  },
  "bugs": {
    "url": "https://example.com/dbx/issues"
  },
  "keywords": [
    "cli",
    "mysql",
    "redis",
    "database",
    "codex"
  ],
  "bin": {
    "dbx": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "profiles.example.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:docker": "bash scripts/docker-smoke-test.sh",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.11.5",
    "redis": "^4.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
